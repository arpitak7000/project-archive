# ─────────────────────────────────────────────────────────────────
# Maitri Gift Shop — Environment Variables
# Copy this file to .env and fill in your values.
# On Replit, DATABASE_URL and PG* variables are set automatically
# when you enable the built-in PostgreSQL database.
# ─────────────────────────────────────────────────────────────────

# Flask secret key (change this to a long random string in production)
SECRET_KEY=your-secret-key-here

# PostgreSQL connection string (set automatically by Replit)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Individual PostgreSQL credentials (also set automatically by Replit)
PGHOST=your-pg-host
PGPORT=5432
PGUSER=your-pg-user
PGPASSWORD=your-pg-password
PGDATABASE=your-pg-database
